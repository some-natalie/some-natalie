# kinda sorta secret stuff, change it obvs

# open-webui
WEBUI_SECRET_KEY=test

# elasticsearch
ELASTIC_PASSWORD=test

# code-index.py -- blank means "use the default shown in the comment"
ELASTIC_USER=
# needed for --knowledge; Open WebUI Settings -> Account -> API keys
OPEN_WEBUI_TOKEN=
# directories to index, separated by ':' -- blank prompts you for them
CODE_INDEX_ROOTS=
ES_URL=
OLLAMA_URL=
OPEN_WEBUI_URL=
CODE_INDEX_INDEX=
CODE_INDEX_KNOWLEDGE_NAME=
EMBED_MODEL=
EMBED_DIMS=
# comma-separated; add a GitHub Enterprise Server host to read it via the REST API
GITHUB_HOSTS=
# comma-separated host suffixes that get the gh token on plain fetches
CODE_INDEX_AUTH_HOSTS=
# 1 disables TLS verification on external fetches, for TLS-inspecting proxies
CODE_INDEX_INSECURE_TLS=
# comma-separated dir names whose JSON stays out of the Open WebUI collection
CODE_INDEX_KNOWLEDGE_SKIP_DIRS=
# path to the gh binary; blank checks the usual install paths before PATH
GH_BIN=
