# Copy to .env and fill in. Everything here is either a secret or installation-specific, which is
# why .env is gitignored and this file is not.
#
#   openssl rand -hex 32     generates any of the random values below

# --- clickhouse -------------------------------------------------------------------------------
# Holds both datasets: the acp database (wire traffic) and Langfuse's own tables.
# Must match ACP_TAP_PASSWORD in ~/.config/acp-tap/env if you run the tap.
CLICKHOUSE_PASSWORD=

# --- langfuse ---------------------------------------------------------------------------------
# Login seeded on first boot, at http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=local
LANGFUSE_INIT_USER_PASSWORD=

# Project keys. Also how litellm authenticates when it ships traces, so they are not optional.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-

# Internals. Random values; SALT and ENCRYPTION_KEY cannot be changed after first boot without
# invalidating what is already stored. ENCRYPTION_KEY must be exactly 64 hex characters.
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=

# --- litellm ----------------------------------------------------------------------------------
# What clients send as their API key when talking to litellm on :4141.
LITELLM_MASTER_KEY=

# The container writes to the mounted SSO token cache, so it runs as you rather than root —
# otherwise root-owned cache files break the host's own aws cli. Check with: id -u ; id -g
HOST_UID=501
HOST_GID=20

# --- bedrock (optional) -----------------------------------------------------------------------
# Only needed for the bedrock models in litellm-config.yaml. Leave blank and those entries fail
# to authenticate while the local ollama ones keep working.
#
# AWS_PROFILE is a profile in ~/.aws/config, which is mounted read-only into the container.
# The runtime endpoint is only required if you reach Bedrock through a VPC endpoint; otherwise
# leave it blank and litellm uses the public regional endpoint.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_BEDROCK_RUNTIME_ENDPOINT=

# Application-inference-profile ARNs, one per tier. Blank is fine if you invoke foundation models
# directly — delete the matching model_id lines from litellm-config.yaml as well.
#   arn:aws:bedrock:<region>:<account-id>:application-inference-profile/<id>
BEDROCK_PROFILE_OPUS_5_5=
BEDROCK_PROFILE_OPUS=
BEDROCK_PROFILE_SONNET=
BEDROCK_PROFILE_HAIKU=

# OpenAI GPT-6, for playground comparisons against the Claude tiers. Not usable from Claude Code.
# These need the BedrockUser policy to allow invoke on openai.gpt-6-* foundation models — without
# it the profile ARN resolves and every call returns AccessDeniedException.
BEDROCK_PROFILE_GPT6_ASTRA=
BEDROCK_PROFILE_GPT6_SOL=
BEDROCK_PROFILE_GPT6_LUNA=

# --- ollama (optional) ------------------------------------------------------------------------
# Where litellm reaches ollama. The default assumes ollama runs on the host, not in compose.
OLLAMA_BASE=http://host.docker.internal:11434
