#!/usr/bin/python3
"""Seed Langfuse dashboards for the agent traces in this stack.

Three dashboards, built from what the data actually supports:

  agent cost        spend by model and by session, cache share, token mix
  agent errors      why model requests fail, which routes are dead
  agent activity    tool calls, latency, throughput

Why this writes to Postgres instead of calling an API: Langfuse has no public dashboards
endpoint (/api/public/dashboards is 404 on 4.46). Dashboards and their widgets are rows in
langfuse-postgres — `dashboards` holds the grid layout, `dashboard_widgets` holds one row
per panel — and the UI reads them straight from there. So seeding is an upsert into two
tables, which is also why it is idempotent: ids are derived from the widget key, so a
re-run updates in place rather than stacking duplicates.

What the widget rows may contain is NOT free-form. Each one is a query the UI builds
through Langfuse's own query layer, so only its declared dimensions and measures exist,
and the three constraints that shaped every panel here are:

  * view=OBSERVATIONS only. The `traces` view does not exist in v4 events-only mode, which
    this deployment runs — a widget using it fails at render with an opaque error.
  * metadata is a FILTER, not a dimension. The failure cause lives in
    metadata.attributes.error.type, and there is no way to group by it, so an error panel
    is one widget per cause with a `stringObject` filter rather than a single breakdown.
  * a high-cardinality dimension (sessionId, id, traceId) needs a row_limit in
    chart_config. The UI derives the matching `orderBy` itself from the first metric
    (buildWidgetOrderBy), so chart_config carrying row_limit is the whole requirement, but
    without it the query is rejected.

Every query below was run against /api/public/v2/metrics before being written, which is
what --verify re-runs. The DB and the API disagree on one field name: the row stores
`agg`, the API takes `aggregation`.

Usage:
  ./langfuse-dashboards --self-check    assert the builders, no network, no disk
  ./langfuse-dashboards --verify        run every widget's query through the API, write nothing
  ./langfuse-dashboards --dry-run       print the SQL that would run
  ./langfuse-dashboards                 upsert the dashboards
  ./langfuse-dashboards --delete        remove them
"""

import base64
import datetime
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

_HERE = os.path.dirname(os.path.abspath(__file__))

PROJECT_ID = "pi"  # this compose file initialises exactly one project
POSTGRES_CONTAINER = "langfuse-postgres"

# Ids are derived, not random: "acp-cost-by-model" every run, so a second run updates the
# same row. A uuid here would mean every run added another copy of every panel.
ID_PREFIX = "acp"


# ---- widget builders ----
# A widget is a view, a breakdown, a measure and a chart type. These wrappers exist so a
# panel reads as one line and the awkward parts — chart_config needing row_limit for the
# high-cardinality breakdowns, `agg` vs `aggregation` — are in one place rather than
# repeated twenty times.


def widget(key, name, description, chart, measure, agg, dimensions=(), filters=(), row_limit=None):
    """One dashboard panel. `key` becomes the row id, so it must be stable across runs."""
    config = {"type": chart}
    if row_limit is not None:
        config["row_limit"] = row_limit
    return {
        "key": key,
        "id": "%s-%s" % (ID_PREFIX, key),
        "name": name,
        "description": description,
        "view": "OBSERVATIONS",
        "chart_type": chart,
        # The row stores `agg`; the metrics API calls the same field `aggregation`.
        "metrics": [{"measure": measure, "agg": agg}],
        "dimensions": [{"field": f} for f in dimensions],
        "filters": list(filters),
        "chart_config": config,
    }


# A failed request is level=ERROR on a GENERATION row. Reused by every error panel.
ERROR_ONLY = {"type": "stringOptions", "column": "level", "operator": "any of", "value": ["ERROR"]}


def error_cause(key, name, etype, note):
    """A panel counting one error cause, broken down by model.

    The cause cannot be a dimension — metadata is filter-only — so each cause gets its own
    widget with a `contains` filter on attributes.error.type. Breaking down by model is
    what makes it useful: it shows whether a cause is one broken route or everything.
    """
    return widget(
        key, name, note, "HORIZONTAL_BAR", "count", "count",
        dimensions=["providedModelName"],
        filters=[
            ERROR_ONLY,
            {"type": "stringObject", "column": "metadata",
             "key": "attributes.error.type", "operator": "contains", "value": etype},
        ],
        row_limit=20,
    )


