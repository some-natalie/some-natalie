def layout(widgets):
    """Place widgets on the 12-column grid.

    A NUMBER tile is a small square; everything else takes half the width. Rows are filled
    left to right and wrap at 12 columns, which keeps this a function of the widget list
    rather than a hand-maintained table of coordinates that drifts when a panel is added.
    """
    placed, x, y, row_height = [], 0, 0, 0
    for w in widgets:
        is_tile = w["chart_type"] == "NUMBER"
        xs, ys = (3, 3) if is_tile else (6, 5)
        if x + xs > 12:
            x, y = 0, y + row_height
            row_height = 0
        placed.append({
            "id": w["id"], "type": "widget", "widgetId": w["id"],
            "x": x, "y": y, "x_size": xs, "y_size": ys,
        })
        x += xs
        row_height = max(row_height, ys)
    return {"widgets": placed}


# ---- sql ----
# Parameters go through a $1..$n list rather than string formatting: these values include
# descriptions with apostrophes, and a quote in a panel description should not be able to
# end a SQL literal.


def sql_statements(dashboards):
    """The upserts, as (sql, params) pairs."""
    out = []
    for dash in dashboards:
        for w in dash["widgets"]:
            out.append((
                """
                INSERT INTO dashboard_widgets
                  (id, project_id, name, description, view, dimensions, metrics, filters,
                   chart_type, chart_config, created_at, updated_at)
                VALUES ($1, $2, $3, $4, $5::"DashboardWidgetViews", $6::jsonb, $7::jsonb,
                        $8::jsonb, $9::"DashboardWidgetChartType", $10::jsonb,
                        CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
                ON CONFLICT (id) DO UPDATE SET
                  name = EXCLUDED.name, description = EXCLUDED.description,
                  view = EXCLUDED.view, dimensions = EXCLUDED.dimensions,
                  metrics = EXCLUDED.metrics, filters = EXCLUDED.filters,
                  chart_type = EXCLUDED.chart_type, chart_config = EXCLUDED.chart_config,
                  updated_at = CURRENT_TIMESTAMP
                """,
                [w["id"], PROJECT_ID, w["name"], w["description"], w["view"],
                 json.dumps(w["dimensions"]), json.dumps(w["metrics"]),
                 json.dumps(w["filters"]), w["chart_type"], json.dumps(w["chart_config"])],
            ))
        out.append((
            """
            INSERT INTO dashboards
              (id, project_id, name, description, definition, filters, created_at, updated_at)
            VALUES ($1, $2, $3, $4, $5::jsonb, '[]'::jsonb,
                    CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
            ON CONFLICT (id) DO UPDATE SET
              name = EXCLUDED.name, description = EXCLUDED.description,
              definition = EXCLUDED.definition, updated_at = CURRENT_TIMESTAMP
            """,
            ["%s-%s" % (ID_PREFIX, dash["key"]), PROJECT_ID, dash["name"],
             dash["description"], json.dumps(layout(dash["widgets"]))],
        ))
    return out


def delete_statements(dashboards):
    ids = ["%s-%s" % (ID_PREFIX, d["key"]) for d in dashboards]
    widget_ids = [w["id"] for d in dashboards for w in d["widgets"]]
    return [
        ("DELETE FROM dashboards WHERE id = ANY($1::text[])", ["{%s}" % ",".join(ids)]),
        ("DELETE FROM dashboard_widgets WHERE id = ANY($1::text[])",
         ["{%s}" % ",".join(widget_ids)]),
    ]


def _psql(sql, params):
    """Run one statement in the Postgres container."""
    password = _env("LANGFUSE_POSTGRES_PASSWORD")
    # check=False because the returncode is handled below: psql's own stderr names the
    # column or constraint that failed, which is more use than a CalledProcessError.
    proc = subprocess.run(
        ["docker", "exec", "-e", "PGPASSWORD=" + password, POSTGRES_CONTAINER,
         "psql", "-U", "postgres", "-v", "ON_ERROR_STOP=1", "-q",
         "-c", _inline(sql, params)],
        capture_output=True, text=True, check=False)
    if proc.returncode:
        sys.exit("psql failed: %s" % (proc.stderr.strip() or proc.stdout.strip()))
    return proc.stdout


def _quote(value):
    """A Postgres string literal. Doubling the quote is the escape."""
    return "'" + str(value).replace("'", "''") + "'"


def _inline(sql, params):
    """Substitute $1..$n with quoted literals.

    psql's own -v variables are not SQL parameters — they interpolate before parsing, so
    they offer no quoting — and passing a statement over -c is the only shape that works
    through `docker exec`. So quoting happens here, highest index first so $10 is not
    rewritten as $1 followed by a literal 0.
    """
    for i in range(len(params), 0, -1):
        sql = sql.replace("$%d" % i, _quote(params[i - 1]))
    return sql


def _env(name):
    value = os.environ.get(name)
    if value:
        return value
    try:
        with open(os.path.join(_HERE, ".env")) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith(name + "="):
                    return line.split("=", 1)[1]
    except OSError:
        pass
    sys.exit("%s is not set and not in %s/.env" % (name, _HERE))


# ---- verification ----
# Every widget is a query, and a widget whose query the server rejects renders as an error
# in the UI with no hint as to which field was wrong. So each one is run before it is
# written. This is also the regression check for the three constraints in the docstring:
# the traces view, metadata-as-dimension, and a missing row_limit all fail here first.


def query_for(w, days=14):
    """The metrics-API query a widget turns into.

    Mirrors the UI's own mapping: `agg` becomes `aggregation`, and a breakdown chart with a
    row_limit gets the orderBy the UI derives from the first metric (buildWidgetOrderBy).
    """
    now = datetime.datetime.now(datetime.timezone.utc)
    metrics = [{"measure": m["measure"], "aggregation": m["agg"]} for m in w["metrics"]]
    query = {
        "view": w["view"].lower(),
        "dimensions": w["dimensions"],
        "metrics": metrics,
        "filters": w["filters"],
        "timeDimension": ({"granularity": "day"} if w["chart_type"].endswith("TIME_SERIES")
                          else None),
        "fromTimestamp": (now - datetime.timedelta(days=days)).isoformat(),
        "toTimestamp": now.isoformat(),
    }
    row_limit = w["chart_config"].get("row_limit")
    if row_limit is not None:
        query["config"] = {"type": w["chart_type"], "row_limit": row_limit}
        # Only a breakdown needs the top-N ordering; a NUMBER tile has no dimension to rank.
        if w["dimensions"] and not w["chart_type"].endswith("TIME_SERIES"):
            query["orderBy"] = [{"field": "%s_%s" % (metrics[0]["aggregation"],
                                                     metrics[0]["measure"]),
                                 "direction": "desc"}]
    return query


def verify(dashboards):
    host = os.environ.get("LANGFUSE_HOST", "http://127.0.0.1:3000").rstrip("/")
    auth = base64.b64encode(
        ("%s:%s" % (_env("LANGFUSE_INIT_PROJECT_PUBLIC_KEY"),
                    _env("LANGFUSE_INIT_PROJECT_SECRET_KEY"))).encode()).decode()
    bad = 0
    for dash in dashboards:
        print("\n%s" % dash["name"])
        for w in dash["widgets"]:
            url = "%s/api/public/v2/metrics?%s" % (
                host, urllib.parse.urlencode({"query": json.dumps(query_for(w))}))
            request = urllib.request.Request(url, headers={"Authorization": "Basic " + auth})
            try:
                with urllib.request.urlopen(request, timeout=60) as response:
                    rows = json.load(response).get("data", [])
                # A valid query returning nothing is still worth flagging: it means the panel
                # renders empty, which in this data usually means a measure that is only
                # populated on rows the filter excludes.
                note = "%d rows" % len(rows) if rows else "NO ROWS"
                print("  ok    %-26s %s" % (w["key"], note))
            except urllib.error.HTTPError as exc:
                detail = exc.read().decode()[:200]
                print("  FAIL  %-26s %s" % (w["key"], detail))
                bad += 1
    print("\n%d widget(s) rejected" % bad)
    return 1 if bad else 0


# ---- self-check ----


def _self_check():
    # Every id is unique and stable, which is what makes a re-run an update.
    ids = [w["id"] for d in DASHBOARDS for w in d["widgets"]]
    assert len(ids) == len(set(ids)), "widget ids must be unique"
    assert all(i.startswith(ID_PREFIX + "-") for i in ids)

    # The three hard constraints this deployment imposes, as assertions rather than prose.
    for dash in DASHBOARDS:
        for w in dash["widgets"]:
            assert w["view"] == "OBSERVATIONS", (
                "%s: the traces view does not exist in events-only mode" % w["key"])
            assert all(d["field"] != "metadata" for d in w["dimensions"]), (
                "%s: metadata is filter-only, never a dimension" % w["key"])
            # A high-cardinality breakdown without a row_limit is rejected at query time.
            if any(d["field"] in ("sessionId", "id", "traceId") for d in w["dimensions"]):
                assert w["chart_config"].get("row_limit"), (
                    "%s: a high-cardinality dimension needs a row_limit" % w["key"])

    # The DB column is `agg`; only the API translation says `aggregation`.
    assert all("agg" in m for d in DASHBOARDS for w in d["widgets"] for m in w["metrics"])
    q = query_for(COST_WIDGETS[1])
    assert q["metrics"][0]["aggregation"] == "sum", "the API wants `aggregation`"
    assert "agg" not in q["metrics"][0]
    assert q["view"] == "observations", "the API view name is lowercase"

    # A breakdown with a row_limit gets the orderBy the UI would derive; a NUMBER tile,
    # having no dimension to rank, must not.
    assert query_for(COST_WIDGETS[3])["orderBy"] == [
        {"field": "sum_totalCost", "direction": "desc"}]
    assert "orderBy" not in query_for(COST_WIDGETS[0])
    # A time series is ordered by time, so it takes a granularity and no top-N.
    ts = query_for(COST_WIDGETS[2])
    assert ts["timeDimension"] == {"granularity": "day"} and "orderBy" not in ts

    # Layout: nothing overflows the 12-column grid and no two panels overlap.
    for dash in DASHBOARDS:
        cells = set()
        for p in layout(dash["widgets"])["widgets"]:
            assert p["x"] + p["x_size"] <= 12, "%s overflows the grid" % p["widgetId"]
            for cx in range(p["x"], p["x"] + p["x_size"]):
                for cy in range(p["y"], p["y"] + p["y_size"]):
                    assert (cx, cy) not in cells, "%s overlaps another panel" % p["widgetId"]
                    cells.add((cx, cy))
        # Every widget is placed, or a panel exists that nothing renders.
        assert len(layout(dash["widgets"])["widgets"]) == len(dash["widgets"])

    # Quoting: an apostrophe in a description must not end the literal. Every real
    # description goes through this, and one of them contains "does not".
    assert _quote("it's") == "'it''s'"
    assert _inline("SELECT $1", ["o'brien"]) == "SELECT 'o''brien'"
    # $10 must substitute before $1, or it becomes the first param followed by a "0".
    ten = _inline("$1 $10", ["a", "b", "c", "d", "e", "f", "g", "h", "i", "TENTH"])
    assert ten == "'a' 'TENTH'", ten

    # Error panels must actually filter to errors, or they count every request. The one
    # exception is deliberate: err-requests-by-model is the DENOMINATOR panel, there so the
    # failure counts beside it can be read as a rate, and filtering it to errors would make
    # it a duplicate of err-by-model.
    DENOMINATOR = {"err-requests-by-model"}
    for w in ERROR_WIDGETS:
        if w["key"] in DENOMINATOR:
            assert not any(f.get("column") == "level" for f in w["filters"]), (
                "%s is the denominator panel and must NOT filter to errors" % w["key"])
            continue
        assert any(f.get("column") == "level" for f in w["filters"]), (
            "%s claims to be an error panel but does not filter on level" % w["key"])

    print("self-check ok — %d widgets across %d dashboards"
          % (len(ids), len(DASHBOARDS)))


def main():
    args = sys.argv[1:]
    if "--self-check" in args:
        return _self_check()
    if "--verify" in args:
        return sys.exit(verify(DASHBOARDS))

    statements = delete_statements(DASHBOARDS) if "--delete" in args \
        else sql_statements(DASHBOARDS)
    if "--dry-run" in args:
        for sql, params in statements:
            print(_inline(" ".join(sql.split()), params) + ";")
        print("\n-- %d statement(s), nothing run" % len(statements))
        return

    for sql, params in statements:
        _psql(sql, params)
    if "--delete" in args:
        print("deleted %d dashboard(s) and their widgets" % len(DASHBOARDS))
    else:
        for dash in DASHBOARDS:
            print("%-16s %2d widgets  %s/project/%s/dashboards/%s-%s"
                  % (dash["name"], len(dash["widgets"]),
                     os.environ.get("LANGFUSE_HOST", "http://127.0.0.1:3000").rstrip("/"),
                     PROJECT_ID, ID_PREFIX, dash["key"]))


if __name__ == "__main__":
    main()
